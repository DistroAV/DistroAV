autoload -Uz log_error log_group log_warning

log_group 'Check Linux build platform'

if [[ ! -r /etc/os-release ]] {
	log_error 'Cannot identify Linux distribution from /etc/os-release'
	return 2
}

source /etc/os-release

typeset -gx DISTROAV_CUSTOM_LINUX=0
typeset -gx DISTROAV_CUSTOM_OS_SHORTNAME=${ID:-linux}

case "${ID}:${VERSION_ID}" {
	ubuntu:24.04|ubuntu:26.04|debian:13|fedora:44) ;;
	*)
		typeset -gx DISTROAV_CUSTOM_LINUX=1
		DISTROAV_CUSTOM_OS_SHORTNAME=$(print -r -- ${ID:-linux} | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-')
		log_warning "${PRETTY_NAME:-Linux} is outside the supported distro matrix. Building against system libobs and system libraries; artifacts will be labeled linux-custom-${DISTROAV_CUSTOM_OS_SHORTNAME}."
		;;
}

log_group