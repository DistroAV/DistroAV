autoload -Uz log_error log_group log_warning

if [[ ! -r /etc/os-release ]] {
	log_error 'Cannot identify Linux distribution from /etc/os-release'
	return 2
}

source /etc/os-release

if (( DISTROAV_CUSTOM_LINUX )) {
	if (( $+commands[rpmbuild] )) {
		typeset -gx DISTROAV_PACKAGE_FORMAT=RPM
	} elif (( $+commands[dpkg-deb] )) {
		typeset -gx DISTROAV_PACKAGE_FORMAT=DEB
	} else {
		typeset -gx DISTROAV_PACKAGE_FORMAT=TGZ
	}
	typeset -gx DISTROAV_OBS_RUNTIME_VERSION=''
	log_warning 'Skipping OBS source build; CMake will use system-installed libobs.'
	return 0
}

local -a sudo_cmd=()
if (( EUID != 0 )) sudo_cmd=(sudo)

if [[ ${ID} == fedora ]] {
	log_group 'Install Fedora build dependencies'
	${sudo_cmd[@]} dnf install -y \
		"https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${VERSION_ID}.noarch.rpm"
	${sudo_cmd[@]} dnf install -y \
		cmake ninja-build jq pkgconf-pkg-config git curl zsh ccache rpm-build libcurl-devel \
		extra-cmake-modules uthash-devel ffmpeg-free-devel \
		libX11-devel libX11-xcb-devel libxcb-devel libxcb-util-devel \
		libxcb-xinerama-devel libxcb-randr-devel libxcb-shm-devel libxcb-devel \
		mesa-libGL-devel libdrm-devel wayland-devel libxkbcommon-devel \
		pulseaudio-libs-devel jansson-devel libuuid-devel zlib-devel simde-devel \
		qt6-qtbase-devel qt6-qtsvg-devel obs-studio
	typeset -gx DISTROAV_PACKAGE_FORMAT=RPM
} else {
	log_group 'Install Debian-family build dependencies'
	${sudo_cmd[@]} apt-get update
	if [[ ${ID} == ubuntu ]] {
		${sudo_cmd[@]} apt-get install -y --no-install-recommends software-properties-common
		${sudo_cmd[@]} add-apt-repository --yes ppa:obsproject/obs-studio
		${sudo_cmd[@]} apt-get update
	}
	${sudo_cmd[@]} apt-get install -y --no-install-recommends \
		build-essential cmake ninja-build jq pkg-config git curl zsh ccache libcurl4-openssl-dev libsimde-dev \
		extra-cmake-modules uthash-dev libavcodec-dev libavformat-dev \
		libswscale-dev libswresample-dev libx11-dev libx11-xcb-dev \
		libxcb1-dev libxcb-xinput-dev libgl1-mesa-dev libwayland-dev \
		libxkbcommon-dev libdrm-dev libpulse-dev libjansson-dev uuid-dev \
		zlib1g-dev qt6-base-dev qt6-base-private-dev obs-studio
	if [[ ${ID} == ubuntu ]] {
		${sudo_cmd[@]} apt-get install -y --no-install-recommends libqt6svg6-dev
	} else {
		${sudo_cmd[@]} apt-get install -y --no-install-recommends qt6-svg-dev
	}
	typeset -gx DISTROAV_PACKAGE_FORMAT=DEB
}
log_group

local deps_dir=${project_root}/.deps
local obs_prefix=${deps_dir}/obs-install
local obs_version obs_base obs_hash
obs_version=$(jq -r '.dependencies["obs-studio"].version' ${project_root}/buildspec.json)
obs_base=$(jq -r '.dependencies["obs-studio"].baseUrl' ${project_root}/buildspec.json)
obs_hash=$(jq -r '.dependencies["obs-studio"].hashes.linux' ${project_root}/buildspec.json)
typeset -gx DISTROAV_OBS_RUNTIME_VERSION=${obs_version}
local obs_src=${deps_dir}/obs-studio-${obs_version}
local obs_archive=${deps_dir}/obs-${obs_version}.tar.gz
local obs_build=${deps_dir}/obs-build-${obs_version}
local obs_version_file=${obs_prefix}/.obs-source-version
local installed_obs_version=''

mkdir -p ${deps_dir}

if [[ ! -d ${obs_src} ]] {
	curl -fsSL ${obs_base}/${obs_version}.tar.gz -o ${obs_archive}
	local archive_hash
	archive_hash=$(sha256sum ${obs_archive})
	archive_hash=${archive_hash%% *}
	if [[ ${archive_hash} != ${obs_hash} ]] {
		log_error "OBS ${obs_version} source archive checksum mismatch"
		return 2
	}
	tar -xf ${obs_archive} -C ${deps_dir}
}

if [[ -r ${obs_version_file} ]] installed_obs_version=$(<${obs_version_file})

if [[ ! -f ${obs_prefix}/lib/cmake/libobs/libobsConfig.cmake || ${installed_obs_version} != ${obs_version} ]]; then
	cmake -S ${obs_src} -B ${obs_build} -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=${obs_prefix} \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_PREFIX_PATH=${obs_prefix} \
		-DOBS_VERSION_OVERRIDE=${obs_version} \
		-DENABLE_FRONTEND=OFF -DENABLE_UI=OFF -DENABLE_FRONTEND_API=ON \
		-DENABLE_PLUGINS=OFF -DENABLE_SCRIPTING=OFF -DENABLE_BROWSER=OFF \
		-DENABLE_WEBSOCKET=OFF -DENABLE_NEW_MPEGTS_OUTPUT=OFF -DENABLE_AJA=OFF \
		-DENABLE_WEBRTC=OFF -DENABLE_VST=OFF \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Wno-dev
	cmake --build ${obs_build}
	cmake --install ${obs_build}
	print -r -- ${obs_version} > ${obs_version_file}
fi